/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sftransitwatch",
	"main": "src/worker-entry.ts",
	"compatibility_date": "2026-04-20",
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	"upload_source_maps": true,
	"kv_namespaces": [
		{
			"binding": "TRANSIT_CACHE",
			"id": "__TRANSIT_CACHE_KV_ID__"
		},
		{
			"binding": "CLIENT_TOKENS",
			"id": "__CLIENT_TOKENS_KV_ID__"
		}
	],
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"APPSTORE_APP_APPLE_ID": "__APPSTORE_APP_APPLE_ID__"
	},
	"custom_domains": [
		"__WORKER_HOSTNAME__"
	],
	"routes": [
		{
			"pattern": "api.sftransitwatch.com",
			"zone_name": "sftransitwatch.com",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	]
}
