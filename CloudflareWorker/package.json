{
	"name": "sftransitwatch",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"prepare:wrangler": "node scripts/prepare-wrangler.mjs",
		"test": "vitest run",
		"deploy": "npm run prepare:wrangler && wrangler deploy --config .wrangler.generated.jsonc",
		"postdeploy": "bash scripts/check-appstore-health.sh",
		"dev": "npm run prepare:wrangler && wrangler dev --config .wrangler.generated.jsonc",
		"start": "npm run prepare:wrangler && wrangler dev --config .wrangler.generated.jsonc",
		"cf-typegen": "npm run prepare:wrangler && wrangler types --config .wrangler.generated.jsonc"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.20.3",
		"@types/node": "^25.6.0",
		"typescript": "^5.5.2",
		"vitest": "^4.1.5",
		"wrangler": "^4.120.0"
	},
	"dependencies": {
		"@apple/app-store-server-library": "3.1.0"
	}
}
